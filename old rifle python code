import tkinter as tk
from tkinter import ttk
import serial
import serial.tools.list_ports
import threading
import math
import pygame

# === Constants ===
WINDOW_SIZE = 500
TARGET_RADIUS = 200
DOT_RADIUS = 5
COOLDOWN_MS = 1000
CALIB_CENTER_PITCH = 3.99
CALIB_CENTER_YAW = 41.75
FIRE_WAV = "fire.wav"

# === App State ===
x = WINDOW_SIZE // 2
y = WINDOW_SIZE // 2
offset_pitch = 0
offset_yaw = 0
calibrated = False
cooldown = False
shots = []
show_dot = True

last_pitch = 0
last_yaw = 0

# === GUI Setup ===
root = tk.Tk()
root.title("Virtual Rifle")
root.configure(bg="yellow")

canvas = tk.Canvas(root, width=WINDOW_SIZE, height=WINDOW_SIZE, bg="black", highlightthickness=0)
canvas.grid(row=0, column=0, rowspan=10, padx=10, pady=10)

def draw_target():
    canvas.delete("target")
    for i in range(10):
        r = TARGET_RADIUS * (10 - i) / 10
        canvas.create_oval(WINDOW_SIZE/2 - r, WINDOW_SIZE/2 - r,
                           WINDOW_SIZE/2 + r, WINDOW_SIZE/2 + r,
                           outline="white", tags="target")

draw_target()

port_var = tk.StringVar()
ports = [p.device for p in serial.tools.list_ports.comports()]
port_var.set(ports[0] if ports else "")
port_menu = ttk.Combobox(root, textvariable=port_var, values=ports, width=10)
port_menu.grid(row=0, column=1)

def connect_serial():
    global ser
    try:
        ser = serial.Serial(port_var.get(), 9600, timeout=1)
        status_label.config(text="Connected", fg="green")
        threading.Thread(target=read_serial, daemon=True).start()
    except:
        status_label.config(text="Connection Failed", fg="red")

tk.Button(root, text="Connect", command=connect_serial).grid(row=1, column=1)
status_label = tk.Label(root, text="Not connected", fg="red", bg="yellow")
status_label.grid(row=2, column=1)

tk.Label(root, text="Sensitivity", bg="yellow").grid(row=3, column=1)
sens_scale = tk.Scale(root, from_=1.0, to=15.0, resolution=0.1, orient=tk.VERTICAL, length=300, bg="yellow")
sens_scale.set(7.0)
sens_scale.grid(row=4, column=1)

score_label = tk.Label(root, text="Score: 0", bg="yellow", font=("Arial", 14))
score_label.grid(row=5, column=1)

calib_label = tk.Label(root, text="Not Calibrated", bg="yellow", fg="red")
calib_label.grid(row=6, column=1)

# === New Buttons ===
def toggle_dot():
    global show_dot
    show_dot = not show_dot
    draw_all()
    dot_button.config(text="Show Dot" if not show_dot else "Hide Dot")

def clear_shots():
    global shots
    shots = []
    draw_all()
    score_label.config(text="Score: 0")

dot_button = tk.Button(root, text="Hide Dot", command=toggle_dot)
dot_button.grid(row=7, column=1, pady=5)

clear_button = tk.Button(root, text="Refresh", command=clear_shots)
clear_button.grid(row=8, column=1, pady=5)

# === Sound ===
pygame.mixer.init()
try:
    fire_sound = pygame.mixer.Sound(FIRE_WAV)
except:
    fire_sound = None

# === Core Functions ===
def fire_shot():
    global cooldown
    if cooldown:
        return
    if fire_sound:
        fire_sound.play()
    shots.append((x, y))
    score = get_score(x, y)
    score_label.config(text=f"Score: {score}")
    cooldown = True
    root.after(COOLDOWN_MS, lambda: set_cooldown(False))

def set_cooldown(val):
    global cooldown
    cooldown = val

def get_score(px, py):
    dx = px - WINDOW_SIZE / 2
    dy = py - WINDOW_SIZE / 2
    dist = math.hypot(dx, dy)
    ring = int(dist / (TARGET_RADIUS / 10))
    return max(0, 10 - ring)

def draw_all():
    canvas.delete("dots")
    for sx, sy in shots:
        canvas.create_oval(sx - DOT_RADIUS, sy - DOT_RADIUS,
                           sx + DOT_RADIUS, sy + DOT_RADIUS,
                           fill="red", tags="dots")
    if show_dot:
        canvas.create_oval(x - DOT_RADIUS, y - DOT_RADIUS,
                           x + DOT_RADIUS, y + DOT_RADIUS,
                           fill="yellow", tags="dots")

def read_serial():
    global x, y, offset_pitch, offset_yaw, calibrated
    global last_pitch, last_yaw

    while True:
        try:
            line = ser.readline().decode().strip()
            if line == "CALIBRATE":
                offset_pitch = last_pitch - CALIB_CENTER_PITCH
                offset_yaw = last_yaw - CALIB_CENTER_YAW
                calibrated = True
                calib_label.config(text="Calibrated!", fg="green")
                continue

            parts = line.split(",")
            if len(parts) != 3:
                continue

            pitch = float(parts[0])
            yaw = float(parts[1])
            fire = int(parts[2])

            last_pitch = pitch
            last_yaw = yaw

            if not calibrated:
                calib_label.config(text="Not Calibrated", fg="red")
                continue

            adj_pitch = pitch - offset_pitch
            adj_yaw = yaw - offset_yaw

            sensitivity = sens_scale.get()

            y_calc = int(WINDOW_SIZE / 2 + (adj_pitch - CALIB_CENTER_PITCH) * (sensitivity * 3.5))
            y = max(0, min(WINDOW_SIZE, y_calc))

            x_calc = int(WINDOW_SIZE / 2 - (adj_yaw - CALIB_CENTER_YAW) * sensitivity)
            x = max(0, min(WINDOW_SIZE, x_calc))

            if fire == 1:
                fire_shot()

            draw_all()
        except Exception as e:
            print("Error:", e)

draw_all()
root.mainloop()
