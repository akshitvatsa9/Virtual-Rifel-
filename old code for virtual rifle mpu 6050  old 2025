#include <Wire.h>

const int MPU = 0x68;

float pitch = 0;
float yaw_angle = 0;
unsigned long last_time = 0;

const int firePin = A0;       // Joystick Y-axis = FIRE
const int calibratePin = A1;  // Joystick X-axis = CALIBRATE

void setup() {
  Serial.begin(9600);
  Wire.begin();

  // Wake up MPU6050
  Wire.beginTransmission(MPU);
  Wire.write(0x6B);
  Wire.write(0);
  Wire.endTransmission(true);
}

void loop() {
  Wire.beginTransmission(MPU);
  Wire.write(0x3B);
  Wire.endTransmission(false);
  Wire.requestFrom(MPU, 14, true);

  int16_t accX = Wire.read() << 8 | Wire.read();
  int16_t accY = Wire.read() << 8 | Wire.read();
  int16_t accZ = Wire.read() << 8 | Wire.read();
  Wire.read(); Wire.read(); // temp
  Wire.read(); Wire.read(); // gyroX
  Wire.read(); Wire.read(); // gyroY
  int16_t gyroZ = Wire.read() << 8 | Wire.read();

  float ax = accX / 16384.0;
  float ay = accY / 16384.0;
  float az = accZ / 16384.0;

  pitch = atan2(ax, sqrt(ay * ay + az * az)) * 180 / PI;

  float gz = gyroZ / 131.0;
  unsigned long now = millis();
  float dt = (now - last_time) / 1000.0;
  last_time = now;

  if (abs(gz) > 1.8) {
    yaw_angle += gz * dt;
  }

  int fireVal = analogRead(firePin);
  int calibVal = analogRead(calibratePin);

  bool fire = fireVal < 300;
  bool calibrate = calibVal < 300;

  if (calibrate) {
    Serial.println("CALIBRATE");
  } else {
    Serial.print(pitch); Serial.print(",");
    Serial.print(yaw_angle); Serial.print(",");
    Serial.println(fire ? 1 : 0);
  }

  delay(20);
}
