def add_telemetry(text):

    try:

        if not isinstance(text, str):
            text = str(text)

        telemetry_box.insert(
            tk.END,
            text + "\n"
        )


        result = telemetry_box.count(
            "1.0",
            "end",
            "lines"
        )


        line_count = (
            int(result[0])
            if result
            else 0
        )


        if line_count > 250:

            telemetry_box.delete(
                "1.0",
                "51.0"
            )


        telemetry_box.see(
            tk.END
        )


        telemetry_status.config(
            text="STREAM: ACTIVE",
            fg=ACCENT_GREEN
        )


    except tk.TclError:
        pass


    except Exception as e:

        print(
            f"Telemetry UI error: {e}"
