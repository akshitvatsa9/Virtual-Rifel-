# SIMULATED FIRE BUTTON
# ============================================================

def fire_button_action():

    global cancel_next_shot

    # --------------------------------------------------------
    # SOFTWARE SIMULATION ONLY.
    # No command is sent to the ESP32.
    # --------------------------------------------------------

    if not arming_mode:

        add_telemetry(
            "[SIM] FIRE IGNORED - ARMING OFF"
        )

        return


    if cancel_next_shot:

        cancel_next_shot = False

        add_telemetry(
            "[SIM] SHOT CANCELLED"
        )

        return


    # IMPORTANT:
    # Every press directly records one simulated shot.
    #
    # There is NO was_firing lock here.
    #
    # Therefore:
    # press -> shot
    # press -> shot
    # press -> shot
    # press -> shot

    record_simulated_shot()


