# ============================================================
# TELEMETRY PARSER
# ============================================================

def process_telemetry(line):

    global x
    global y
    global center_pitch
    global center_yaw
    global calibrated
    global live_path
    global current_pitch
    global current_yaw
    global last_hardware_fire
    global cancel_next_shot

    parts = line.split(",")

    if len(parts) != 4:
        return

    try:

        pitch = float(parts[0].strip())
        yaw = float(parts[1].strip())

        fire = int(parts[2].strip())
        calibrate = int(parts[3].strip())

    except (ValueError, TypeError):

        return


    # ========================================================
    # TELEMETRY DISPLAY
    # ========================================================

    add_telemetry(line)

    current_pitch = pitch
    current_yaw = yaw


    # ========================================================
    # CALIBRATION
    # ========================================================

    if calibrate:

        center_pitch = pitch
        center_yaw = yaw

        calibrated = True

        live_path = []


    if not calibrated:

        telemetry_status.config(
            text="STREAM: ACTIVE / UNCALIBRATED",
            fg=ACCENT_YELLOW
        )

        return


    # ========================================================
    # RELATIVE ANGLES
    # ========================================================

    rel_pitch = (
        pitch - center_pitch
    )

    rel_yaw = (
        yaw - center_yaw
    )


    # ========================================================
    # TAN THETA MAPPING
    # ========================================================

    TARGET_DISTANCE = 10.0

    pitch_rad = math.radians(
        rel_pitch
    )

    yaw_rad = math.radians(
        rel_yaw
    )

    x_offset = (
        TARGET_DISTANCE *
        math.tan(yaw_rad)
    )

    y_offset = (
        TARGET_DISTANCE *
        math.tan(pitch_rad)
    )


    # ========================================================
    # SENSITIVITY 1 - 100
    #
    # IMPORTANT:
    #
    # Old system:
    #   sensitivity 20 -> 20 * 10 = 200
    #
    # New system:
    #   sensitivity 20 -> 20 * 10 = 200
    #   sensitivity 40 -> 40 * 10 = 400
    #   sensitivity 100 -> 100 * 10 = 1000
    #
    # So the old behavior at 1-20 is preserved exactly.
    # ========================================================

    PIXELS_PER_METER = (
        float(sens.get()) * 10
    )


    x = int(
        WINDOW_SIZE / 2
        - x_offset * PIXELS_PER_METER
    )

    y = int(
        WINDOW_SIZE / 2
        - y_offset * PIXELS_PER_METER
    )


    x = max(
        0,
        min(WINDOW_SIZE, x)
    )

    y = max(
        0,
        min(WINDOW_SIZE, y)
    )


    # ========================================================
    # LIVE PATH
    # ========================================================

    if draw_live_line:

        if (
            not live_path
            or live_path[-1] != (x, y)
        ):

            live_path.append(
                (x, y)
            )

            if len(live_path) > 150:
                live_path.pop(0)


    # ========================================================
    # HARDWARE SIMULATED SHOT
    #
    # FIX:
    #
    # The previous system used was_firing in a way that could
    # cause alternating trigger behavior.
    #
    # Now a FIRE event is accepted whenever the incoming fire
    # signal changes from 0 -> 1.
    #
    # This is still LOCAL SIMULATION ONLY.
    # No firing command is transmitted.
    # ========================================================

    if fire == 1 and last_hardware_fire == 0:

        if not arming_mode:

            add_telemetry(
                "[SIM] FIRE EVENT IGNORED - ARMING OFF"
            )

        elif cancel_next_shot:

            cancel_next_shot = False

            add_telemetry(
                "[SIM] SHOT CANCELLED"
            )

        else:

            record_simulated_shot()


    # Remember current hardware trigger state.
    last_hardware_fire = 1 if fire else 0


    redraw()


# ============================================================
# SIMULATED SHOT RECORDING
# ============================================================

def record_simulated_shot():

    current_score = score(
        x,
        y
    )

    timestamp = datetime.now().strftime(
        "%H:%M:%S"
    )

    shots.append(
        (
            x,
            y,
            timestamp,
            current_score
        )
    )

    score_label.config(
        text=f"SCORE: {current_score:02d}"
    )

    update_table()

    add_telemetry(
        f"[SIM] SHOT RECORDED | "
        f"X={x} Y={y} | "
        f"SCORE={current_score:02d}"
    )

    play_sound()

    redraw()


