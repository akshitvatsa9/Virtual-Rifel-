def play_sound():

    if not sound_enabled:
        return

    def _play():

        try:

            current_os = platform.system()

            sound_file = "fire.wav"

            if os.path.exists(sound_file):

                if current_os == "Windows":

                    import winsound

                    winsound.PlaySound(
                        sound_file,
                        winsound.SND_FILENAME |
                        winsound.SND_ASYNC |
                        winsound.SND_NOSTOP
                    )

                elif current_os == "Darwin":

                    os.system(
                        f'afplay "{sound_file}" '
                        '>/dev/null 2>&1 &'
                    )

                else:

                    os.system(
                        f'aplay "{sound_file}" '
                        '>/dev/null 2>&1 &'
                    )

            elif current_os == "Windows":

                import winsound

                winsound.Beep(
                    1200,
                    80
                )

        except Exception as e:

            print(
                f"Audio System Exception: {e}"
            )

    threading.Thread(
        target=_play,
        daemon=True
    ).start()


# ============================================================
# SAFE SERIAL DISCONNECT
# ============================================================

def disconnect_serial():

    global ser

    serial_stop_event.set()

    with connection_lock:

        local_ser = ser
        ser = None

    if local_ser is not None:

        try:

            if local_ser.is_open:
                local_ser.close()

        except Exception:
            pass


# ============================================================
# SERIAL CONNECTION
# ============================================================

def connect():

    global ser
    global serial_thread

    port = port_var.get().strip()

    if not port:

        status.config(
            text="NO SERIAL PORT",
            fg=ACCENT_RED
        )

        return

    disconnect_serial()

    time.sleep(0.05)

    try:

        new_ser = serial.Serial(
            port=port,
            baudrate=115200,
            timeout=0.1
        )

        with connection_lock:
            ser = new_ser

        serial_stop_event.clear()

        status.config(
            text="HUD: SERIAL ONLINE",
            fg=ACCENT_CYAN
        )

        serial_thread = threading.Thread(
            target=read_serial,
            daemon=True
        )

        serial_thread.start()

    except Exception as e:

        with connection_lock:
            ser = None

        status.config(
            text="LINK ERROR",
            fg=ACCENT_RED
        )

        print(
            f"Serial connection error: {e}"
        )


