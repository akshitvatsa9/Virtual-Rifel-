def generate_pil_image():

    card_size = 400

    img = Image.new(
        "RGB",
        (card_size, card_size),
        BG_COLOR
    )

    draw = ImageDraw.Draw(img)

    scale = card_size / WINDOW_SIZE

    center = card_size / 2

    tgt_r = TARGET_RADIUS * scale

    for i in range(10):

        r = tgt_r * (10 - i) / 10

        ring_color = (
            "#1E293B"
            if i % 2 == 0
            else ACCENT_CYAN
        )

        draw.ellipse(
            [
                center - r,
                center - r,
                center + r,
                center + r
            ],
            outline=ring_color,
            width=1
        )

    draw.line(
        [
            center - tgt_r,
            center,
            center + tgt_r,
            center
        ],
        fill="#1E293B",
        width=1
    )

    draw.line(
        [
            center,
            center - tgt_r,
            center,
            center + tgt_r
        ],
        fill="#1E293B",
        width=1
    )

    for shot in shots:

        sx = shot[0] * scale
        sy = shot[1] * scale

        draw.ellipse(
            [
                sx - 5,
                sy - 5,
                sx + 5,
                sy + 5
            ],
            outline=ACCENT_RED,
            width=1
        )

        draw.ellipse(
            [
                sx - 1,
                sy - 1,
                sx + 1,
                sy + 1
            ],
            fill=ACCENT_RED
        )

    return img


