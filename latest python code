# ============================================================
# SCORE CALCULATION
# ============================================================

def score(px, py):

    d = math.hypot(
        px - WINDOW_SIZE / 2,
        py - WINDOW_SIZE / 2
    )

    ring = int(
        d / (TARGET_RADIUS / 10)
    )

    return max(
        0,
        10 - ring
    )


