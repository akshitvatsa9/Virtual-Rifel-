# ============================================================
# SERIAL READER
# ============================================================

def read_serial():

    while (
        is_running
        and not serial_stop_event.is_set()
    ):

        with connection_lock:
            local_ser = ser

        if local_ser is None:

            time.sleep(0.05)
            continue


        try:

            if not local_ser.is_open:
                break


            raw = local_ser.readline()


            if raw:

                line = raw.decode(
                    "utf-8",
                    errors="ignore"
                ).strip()


                if line:

                    telemetry_queue.put(
                        line
                    )


        except (
            serial.SerialException,
            OSError,
            PermissionError
        ) as e:

            if not serial_stop_event.is_set():

                root.after(
                    0,
                    lambda: status.config(
                        text="SERIAL DISCONNECTED",
                        fg=ACCENT_RED
                    )
                )

                print(
                    f"Serial reader stopped: {e}"
                )

            break


        except Exception as e:

            if not serial_stop_event.is_set():

                print(
                    f"Serial reader exception: {e}"
                )

            time.sleep(0.1)


# ============================================================
# WIFI READER
# ============================================================

def read_wifi():

    while (
        is_running
        and not wifi_stop_event.is_set()
    ):

        with connection_lock:
            local_socket = udp_socket


        if local_socket is None:

            time.sleep(0.05)
            continue


        try:

            data, addr = local_socket.recvfrom(
                1024
            )


            line = data.decode(
                "utf-8",
                errors="ignore"
            ).strip()


            if line:

                telemetry_queue.put(
                    line
                )


        except socket.timeout:

            continue


        except (
            OSError,
            PermissionError
        ) as e:

            if not wifi_stop_event.is_set():

                print(
                    f"Wi-Fi reader stopped: {e}"
                )

            break


        except Exception as e:

            if not wifi_stop_event.is_set():

                print(
                    f"Wi-Fi reader exception: {e}"
                )

            time.sleep(0.1)


# ============================================================
# TELEMETRY QUEUE PROCESSOR
# ============================================================

def process_telemetry_queue():

    processed = 0


    while processed < 50:

        try:

            line = telemetry_queue.get_nowait()


        except queue.Empty:

            break


        try:

            process_telemetry(
                line
            )


        except Exception as e:

            print(
                f"Telemetry processing error: {e}"
            )


        processed += 1


    if is_running:

        root.after(
            20,
            process_telemetry_queue
        )


