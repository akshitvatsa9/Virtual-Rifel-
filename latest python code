def disconnect_wifi():

    global udp_socket

    wifi_stop_event.set()

    with connection_lock:

        local_socket = udp_socket
        udp_socket = None

    if local_socket is not None:

        try:
            local_socket.close()

        except Exception:
            pass


# ============================================================
# WI-FI
# ============================================================

def connect_wifi():

    global udp_socket
    global wifi_thread

    disconnect_serial()
    disconnect_wifi()

    time.sleep(0.05)

    try:

        new_socket = socket.socket(
            socket.AF_INET,
            socket.SOCK_DGRAM
        )

        new_socket.setsockopt(
            socket.SOL_SOCKET,
            socket.SO_REUSEADDR,
            1
        )

        new_socket.bind(
            ("0.0.0.0", 4210)
        )

        new_socket.settimeout(0.1)

        with connection_lock:
            udp_socket = new_socket

        wifi_stop_event.clear()

        status.config(
            text="HUD: WIFI ONLINE",
            fg=ACCENT_GREEN
        )

        wifi_thread = threading.Thread(
            target=read_wifi,
            daemon=True
        )

        wifi_thread.start()

    except Exception as e:

        with connection_lock:
            udp_socket = None

        status.config(
            text="WIFI LINK ERROR",
            fg=ACCENT_RED
        )

        print(
            f"Network error: {e}"
        )


