        bg=UI_PANEL_BG,
        fg=ACCENT_CYAN,
        insertbackground=ACCENT_CYAN,
        font=("Courier", 10)
    )

    entry_target.pack(
        padx=20,
        pady=5
    )

    entry_target.insert(
        0,
        "+91"
    )


    lbl_wa_status = tk.Label(
        wa_win,
        text="READY TO DISPATCH",
        fg=ACCENT_CYAN,
        bg=BG_COLOR,
        font=("Courier", 9)
    )

    lbl_wa_status.pack(
        pady=2
    )


    def trigger_dispatch():

        raw_phone = entry_target.get().strip()


        if not raw_phone.startswith("+"):

            if (
                raw_phone.startswith("91")
                and len(raw_phone) == 12
            ):

                phone_num = "+" + raw_phone

            else:

                phone_num = "+91" + raw_phone

        else:

            phone_num = raw_phone


        if len(phone_num) < 12:

            lbl_wa_status.config(
                text="INVALID PHONE LENGTH",
                fg=ACCENT_RED
            )

            return


        def async_whatsapp_sender():

            try:

                import pywhatkit as pwk

                temp_filename = (
                    "temp_wa_snapshot.png"
                )

                img = generate_pil_image()

                img.save(
                    temp_filename
                )


                root.after(
                    0,
                    lambda: lbl_wa_status.config(
                        text="OPENING BROWSER...",
                        fg=ACCENT_CYAN
                    )
                )


                pwk.sendwhats_image(
                    receiver=phone_num,
                    img_path=temp_filename,
                    caption=compile_shot_logs(),
                    wait_time=45,
                    tab_close=True,
                    close_time=8
                )


                root.after(
                    0,
                    lambda: lbl_wa_status.config(
                        text="TRANSMISSION COMPLETED",
                        fg=ACCENT_GREEN
                    )
                )


                def cleanup():

                    try:
                        wa_win.destroy()

                    except Exception:
                        pass


                    if os.path.exists(temp_filename):

                        try:
                            os.remove(
                                temp_filename
                            )

                        except Exception:
                            pass


                root.after(
                    1500,
                    cleanup
                )


            except Exception as wa_err:

                root.after(
                    0,
                    lambda: lbl_wa_status.config(
                        text="AUTOMATION REJECTED",
                        fg=ACCENT_RED
                    )
                )

                print(
                    f"WhatsApp Framework Error: {wa_err}"
                )


        threading.Thread(
            target=async_whatsapp_sender,
            daemon=True
        ).start()


    create_hud_button(
        wa_win,
        "DISPATCH WHATSAPP",
        trigger_dispatch,
        color=ACCENT_GREEN
    ).pack(
        pady=(5, 15)
    )


