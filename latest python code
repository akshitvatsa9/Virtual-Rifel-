# ============================================================
# SHOT LOG
# ============================================================

def compile_shot_logs():

    report = "== HUD DATA TERMINAL EXPORT ==\n"

    report += (
        f"Generated: "
        f"{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\n"
    )

    report += (
        f"Total recorded simulated shots: "
        f"{len(shots)}\n"
    )

    report += "---------------------------------------\n"

    for i, (_, _, timestamp, hit_score) in enumerate(
        shots[:50],
        1
    ):

        report += (
            f"Shot #{i:02d} | "
            f"Time: [{timestamp}] | "
            f"Score: {hit_score:02d} Pts\n"
        )

    report += "---------------------------------------\n"
    report += "End of System Stream Log Transmission."

    return report


